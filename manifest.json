{
  "manifest_version": 3,
  "name": "Poker Advisor (duel.com)",
  "version": "1.0.0",
  "description": "Real-time poker decision support for duel.com Arena. Reads the table; never acts on it.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://pvp.duel.com/*",
    "*://*.duel.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://pvp.duel.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "dist/service-worker.js"
  },
  "action": {
    "default_popup": "dist/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/equity-worker.js"
      ],
      "matches": [
        "*://pvp.duel.com/*"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
